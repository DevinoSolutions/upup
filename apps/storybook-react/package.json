{
    "name": "@useupup/storybook-react",
    "version": "0.1.9",
    "private": true,
    "type": "module",
    "scripts": {
        "storybook": "storybook dev -p 53050 --no-open",
        "build-storybook": "storybook build -o storybook-static && node scripts/compose-vue.mjs",
        "test": "vitest run --passWithNoTests",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@useupup/core": "workspace:*",
        "@useupup/react": "workspace:*",
        "react": "^19.2.0",
        "react-dom": "^19.2.0"
    },
    "devDependencies": {
        "@useupup/storybook-config": "workspace:*",
        "storybook": "^10.6.1",
        "@storybook/react-vite": "^10.6.1",
        "@storybook/addon-docs": "^10.6.1",
        "@storybook/addon-a11y": "^10.6.1",
        "@storybook/addon-themes": "^10.6.1",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "msw": "^2.7.0",
        "msw-storybook-addon": "^2.0.4",
        "@tailwindcss/forms": "^0.5.7",
        "@tailwindcss/typography": "^0.5.16",
        "autoprefixer": "^10.4.20",
        "postcss": "^8.5.2",
        "tailwindcss": "^3.4.17",
        "typescript": "^5.3.2",
        "vitest": "^4.1.11"
    },
    "msw": {
        "workerDirectory": [
            "public"
        ]
    }
}
