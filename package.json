{
    "name": "upup",
    "private": true,
    "packageManager": "pnpm@10.11.0",
    "scripts": {
        "prepare": "husky",
        "build": "turbo run build",
        "build:landing": "turbo run build --filter=@useupup/landing",
        "build:package": "pnpm --filter @useupup/core run build && pnpm --filter @useupup/server run build && pnpm --filter @useupup/react run build && pnpm --filter @useupup/vue run build && pnpm --filter @useupup/svelte run build && pnpm --filter @useupup/vanilla run build && pnpm --filter @useupup/angular run build && pnpm --filter @useupup/preact run build && pnpm --filter @useupup/next run build",
        "clean": "turbo run clean",
        "dev": "dotenv -e local-dev/.env.ports -- concurrently \"pnpm run dev:apps\" \"pnpm run dev:package-watch\"",
        "dev:apps": "turbo run dev --parallel --filter=@useupup/landing --filter=@useupup/playground --filter=@useupup/mastra",
        "dev:playground": "pnpm --filter @useupup/playground run dev",
        "build:playground": "turbo run build --filter=@useupup/playground",
        "dev:storybook": "concurrently \"pnpm --filter @useupup/storybook-vue storybook\" \"pnpm --filter @useupup/storybook-react storybook\" \"pnpm --filter @useupup/storybook-svelte storybook\" \"pnpm --filter @useupup/storybook-vanilla storybook\" \"pnpm --filter @useupup/storybook-angular storybook\" \"pnpm --filter @useupup/storybook-preact storybook\"",
        "build:storybook": "turbo run build-storybook",
        "start:playground": "pnpm --filter @useupup/playground run start",
        "dev:package-watch": "pnpm --filter @useupup/core run build && concurrently \"pnpm --filter @useupup/core run dev\" \"pnpm --filter @useupup/server run dev\" \"pnpm --filter @useupup/react run dev\"",
        "dev:all": "turbo run dev --parallel",
        "dev:package": "dotenv -e local-dev/.env.ports -- pnpm run dev:package-watch",
        "lint": "turbo run lint",
        "lint:ox": "oxlint .",
        "prettier-check": "prettier --check \"packages/{core,server,react,vue,svelte,vanilla,angular,preact,next,interactive-example}/src/**/*.{ts,tsx}\" \"apps/{landing,playground}/src/**/*.{ts,tsx}\"",
        "prettier-write": "prettier --write \"packages/{core,server,react,vue,svelte,vanilla,angular,preact,next,interactive-example}/src/**/*.{ts,tsx}\" \"apps/{landing,playground}/src/**/*.{ts,tsx}\"",
        "start": "pnpm --filter @useupup/landing run start",
        "test": "turbo run test --continue",
        "test:coverage": "turbo run test:coverage --continue",
        "test:quality": "node scripts/ci/test-quality-guard.mjs",
        "test:scripts": "node --test scripts/ci/test-quality-guard.test.mjs scripts/ci/resolve-affected-tests.test.mjs scripts/lib/tarball.test.mjs scripts/lib/styles-subpath.test.mjs scripts/lib/release-notes.test.mjs scripts/docs/check-api-sync.test.mjs scripts/docs/check-links.test.mjs scripts/docs/check-coverage.test.mjs scripts/docs/check-snippets.test.mjs scripts/drive-sandbox/seed-escape-twin.test.mjs",
        "docs:api-sync:check": "node scripts/docs/check-api-sync.mjs",
        "docs:links:check": "node scripts/docs/check-links.mjs",
        "docs:snippets:coverage": "node scripts/docs/check-coverage.mjs",
        "docs:snippets:check": "node scripts/docs/check-snippets.mjs",
        "e2e": "turbo run build && pnpm --filter @useupup/e2e-test test:e2e && dotenv -e local-dev/.env.minio -- pnpm --filter @useupup/e2e-test test:e2e:cf",
        "e2e:a11y": "turbo run build && pnpm --filter @useupup/e2e-test test:e2e:a11y",
        "e2e:landing": "dotenv -e local-dev/.env.posthog-e2e -- pnpm --filter @useupup/e2e-test test:e2e:landing",
        "e2e:minio:up": "dotenv -e local-dev/.env.minio -- node scripts/validate-env.mjs && dotenv -e local-dev/.env.minio -- docker compose up -d",
        "env:check": "node scripts/validate-env.mjs --example local-dev/.env.minio.example",
        "vocab:check": "node scripts/check-retired-vocab.mjs",
        "e2e:minio:down": "docker compose down -v",
        "e2e:minio:server": "dotenv -e local-dev/.env.minio -- node scripts/upup-e2e-server.mjs",
        "e2e:minio:test": "dotenv -e local-dev/.env.minio -- pnpm --filter @useupup/server exec vitest run tests/integration",
        "drive:sandbox:mint": "dotenv -e local-dev/.env.test -- node scripts/drive-sandbox/mint.mjs",
        "drive:sandbox:seed": "dotenv -e local-dev/.env.test -- node scripts/drive-sandbox/seed.mjs",
        "drive:sandbox:test": "pnpm --filter @useupup/core build && dotenv -e local-dev/.env.test -- pnpm --filter @useupup/server exec vitest run tests/integration/drive-clients-live.integration.test.ts",
        "drive:sandbox": "pnpm --filter @useupup/core build && pnpm --filter @useupup/server build && dotenv -e local-dev/.env.test -- node scripts/drive-sandbox/rotate-and-test.mjs",
        "smoke:packages": "node scripts/package-smoke-consumer.mjs",
        "audit:prod": "node scripts/audit-prod.mjs",
        "knip": "knip --config knip.jsonc",
        "typecheck": "turbo run typecheck --continue",
        "size": "size-limit",
        "release": "pnpm run build:package && changeset publish",
        "test-release": "pnpm run build:package && pnpm -r publish --dry-run --no-git-checks"
    },
    "devDependencies": {
        "@changesets/changelog-github": "^0.5.1",
        "@changesets/cli": "^2.30.0",
        "@napi-rs/canvas": "^1.0.2",
        "@size-limit/file": "^11.0.0",
        "@useupup/server": "workspace:*",
        "concurrently": "^9.2.1",
        "dotenv-cli": "^7.4.2",
        "express": "^4.21.0",
        "husky": "^9.1.7",
        "knip": "^6.24.0",
        "lint-staged": "^17.0.8",
        "oxlint": "^1.72.0",
        "prettier": "^3.9.4",
        "size-limit": "^11.0.0",
        "turbo": "2.9.14"
    },
    "lint-staged": {
        "*.{ts,tsx,js,jsx,mjs,cjs}": [
            "oxlint",
            "prettier --check"
        ],
        "*.{json,md,yml,yaml}": [
            "prettier --check"
        ]
    },
    "pnpm": {
        "overrides": {
            "fast-xml-parser": "^4.5.5",
            "postcss": ">=8.5.18",
            "prismjs": "^1.29.0",
            "tough-cookie": "^4.1.3",
            "jsdom": "22.1.0",
            "node-notifier": "10.0.1",
            "node-fetch": "2.6.7",
            "rollup": "^3.30.0",
            "vite>rollup": "^4",
            "react": "^19.2.0",
            "react-dom": "^19.2.0",
            "@types/react": "^19",
            "@types/react-dom": "^19",
            "js-yaml@3": "3.15.2",
            "@babel/core@^7.0.0": "^7.29.6",
            "@babel/plugin-transform-modules-systemjs@^7.0.0": "^7.29.4",
            "@grpc/grpc-js@^1.0.0": "^1.14.5",
            "@hono/node-server@^1.0.0": "^1.19.15",
            "@humanfs/node@~0.16.0": "^0.16.8",
            "@tootallnate/once@^2.0.0": "^2.0.1",
            "basic-ftp@^5.0.0": "^6.2.1",
            "body-parser@^1.0.0": "^1.20.6",
            "brace-expansion@^1.0.0": "^1.1.21",
            "brace-expansion@^2.0.0": "^2.1.7",
            "brace-expansion@^5.0.0": "^5.0.12",
            "browserslist@^4.0.0": "^4.28.7",
            "compression@^1.0.0": "^1.8.2",
            "devalue@^5.0.0": "^5.9.3",
            "dompurify@^3.0.0": "^3.4.16",
            "fast-uri@^3.0.0": "^3.1.8",
            "fflate@~0.4.0": "^0.4.9",
            "fflate@~0.8.0": "^0.8.3",
            "follow-redirects@^1.0.0": "^1.16.0",
            "form-data@^4.0.0": "^4.0.6",
            "glob@^10.0.0": "^10.5.0",
            "http-proxy-middleware@^2.0.0": "^2.0.10",
            "http-proxy-middleware@^3.0.0": "^3.0.7",
            "immutable@^5.0.0": "^5.1.8",
            "ip-address@^10.0.0": "^10.7.1",
            "launch-editor@^2.0.0": "^2.14.1",
            "lodash@^4.0.0": "^4.18.0",
            "mdast-util-to-hast@^13.0.0": "^13.2.1",
            "nanoid@^3.0.0": "^3.3.18",
            "node-forge@^1.0.0": "^1.4.0",
            "pacote@^20.0.0": "^21.5.1",
            "path-to-regexp@~0.1.0": "^0.1.13",
            "piscina@^4.0.0": "^4.9.4",
            "postcss-selector-parser@^6.0.0": "^6.1.3",
            "postcss-selector-parser@^7.0.0": "^7.1.6",
            "proxy-addr@^2.0.0": "^2.0.8",
            "qs@^6.0.0": "^6.16.0",
            "serialize-javascript@^6.0.0": "^7.0.5",
            "smol-toml@^1.0.0": "^1.9.0",
            "source-map-js@^1.0.0": "^1.2.2",
            "tar@^7.0.0": "^7.5.21",
            "tmp@<0.2.4": "^0.2.6",
            "uuid@^8.0.0": "^11.1.1",
            "webpack@^5.0.0": "^5.104.1",
            "webpack-dev-middleware@^6.0.0": "^7.4.6",
            "webpack-dev-middleware@^7.0.0": "^7.4.6",
            "webpack-dev-server@^5.0.0": "^5.2.6",
            "websocket-driver@~0.7.0": "^0.7.5",
            "ws@^8.0.0": "^8.21.0",
            "@angular/build>vite": "^6.4.3",
            "@angular/build>esbuild": "^0.28.1",
            "@angular-devkit/build-angular>esbuild": "^0.28.1",
            "tsup>esbuild": "^0.28.1",
            "vite@^7.0.0>esbuild": "^0.28.1"
        },
        "patchedDependencies": {
            "@storybook/angular@9.1.20": "patches/@storybook__angular@9.1.20.patch"
        }
    }
}
